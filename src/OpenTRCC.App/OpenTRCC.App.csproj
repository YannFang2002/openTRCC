<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms + WPF implicit usings collide (Application, MessageBox); be explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>OpenTRCC</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\opentrcc.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>OpenTRCC</Product>
    <AssemblyTitle>OpenTRCC</AssemblyTitle>
    <Authors>Yann Fang</Authors>
    <RepositoryUrl>https://github.com/YannFang2002/openTRCC</RepositoryUrl>
    <RootNamespace>OpenTRCC.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTRCC.Core\OpenTRCC.Core.csproj" />
    <ProjectReference Include="..\OpenTRCC.Devices\OpenTRCC.Devices.csproj" />
    <ProjectReference Include="..\OpenTRCC.Sensors\OpenTRCC.Sensors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon\opentrcc.ico" Link="assets\icon\opentrcc.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\presentmon\**\*"
             Link="third_party\presentmon\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\themes\*.json" Link="themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
