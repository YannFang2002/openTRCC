<ui:FluentWindow x:Class="OpenTRCC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OpenTRCC" Height="620" Width="1010"
        Icon="pack://application:,,,/assets/icon/opentrcc.ico"
        MinHeight="520" MinWidth="900"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18,8,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenTRCC" />

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OpenTRCC" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="DeviceText" Text="未连接" Margin="14,0,0,0"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="就绪" HorizontalAlignment="Right"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavChanged">
                    <ListBoxItem Content="概览" Tag="overview" Padding="10,9" />
                    <ListBoxItem Content="传感器" Tag="sensors" Padding="10,9" />
                    <ListBoxItem Content="编辑器" Tag="editor" Padding="10,9" />
                    <ListBoxItem Content="设置" Tag="settings" Padding="10,9" />
                    <ListBoxItem Content="日志" Tag="logs" Padding="10,9" />
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <!-- 概览 -->
                <Grid x:Name="OverviewPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Width="324" Height="244" Padding="2" VerticalAlignment="Top">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="主题" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6" />
                        <ListBox x:Name="ThemeList" Height="190" Background="{StaticResource PanelBackground}"
                                 BorderBrush="{StaticResource BorderBrush}" SelectionChanged="OnThemeChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="8,5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ui:Button x:Name="StartButton" Content="开始推流" Margin="0,14,0,0" Click="OnStartStopClick" Appearance="Primary" />

                        <CheckBox x:Name="AutostartCheck" Content="开机自启" Margin="2,14,0,0"
                                  Click="OnAutostartClick" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                        <TextBlock Text="FPS" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                        <TextBlock x:Name="FpsText" Text="—" FontSize="22" FontWeight="Bold" Foreground="#34D399"
                                   FontFamily="Consolas" Typography.NumeralAlignment="Tabular" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPU" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                <TextBlock x:Name="CpuText" Text="—" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Consolas" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GPU" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                <TextBlock x:Name="GpuText" Text="—" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Consolas" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="内存" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                <TextBlock x:Name="MemText" Text="—" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Consolas" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="网络 ↓" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                <TextBlock x:Name="NetText" Text="—" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Consolas" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 传感器 -->
                <Grid x:Name="SensorsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBox x:Name="SensorSearch" Width="260" HorizontalAlignment="Left"
                                 TextChanged="OnSensorSearchChanged" />
                        <TextBlock x:Name="SensorCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Grid>

                    <ListView x:Name="SensorList" Grid.Row="1" Background="{StaticResource PanelBackground}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimary}" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="250" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="值" Width="110" DisplayMemberBinding="{Binding Value}" />
                                <GridViewColumn Header="单位" Width="70" DisplayMemberBinding="{Binding Unit}" />
                                <GridViewColumn Header="来源" Width="80" DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="类别" Width="70" DisplayMemberBinding="{Binding Category}" />
                                <GridViewColumn Header="ID" Width="330" DisplayMemberBinding="{Binding Id}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <ContentControl x:Name="EditorPanel" Visibility="Collapsed" />

                <!-- 设置 -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="传感器来源" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6" />
                        <ItemsControl x:Name="SourceStatusList" />

                        <TextBlock Text="设备" Foreground="{StaticResource TextSecondary}" Margin="2,18,0,6" />
                        <TextBlock x:Name="SettingsDeviceText" Text="未连接" FontFamily="Consolas" />

                        <TextBlock Text="显示器（FPS 按 VidPn source 分组）" Foreground="{StaticResource TextSecondary}" Margin="2,14,0,6" />
                        <TextBlock x:Name="DisplaysText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}" />

                        <TextBlock Text="路径" Foreground="{StaticResource TextSecondary}" Margin="2,18,0,6" />
                        <TextBlock x:Name="ThemeDirText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="LogPathText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4" />
                        <TextBlock x:Name="ConfigPathText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="打开日志" Click="OnOpenLogClick" Margin="0,0,8,0" />
                            <Button Content="打开配置目录" Click="OnOpenConfigClick" Margin="0,0,8,0" />
                            <Button Content="复制诊断信息" Click="OnCopyDiagnosticsClick" />
                        </StackPanel>

                        <CheckBox x:Name="SettingsAutostartCheck" Content="开机自启（HKCU）" Margin="2,18,0,0"
                                  Click="OnSettingsAutostartClick" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 日志 -->
                <Grid x:Name="LogsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="打开日志文件" Click="OnOpenLogClick" Margin="0,0,8,0" />
                        <Button Content="清空显示" Click="OnClearLogClick" />
                    </StackPanel>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                             Background="{StaticResource PanelBackground}" Foreground="{StaticResource TextSecondary}"
                             BorderBrush="{StaticResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="关闭窗口会留在托盘继续推流 · 右键托盘图标退出"
                   Foreground="#475569" FontSize="11" Margin="2,14,0,0" />
    </Grid>
</ui:FluentWindow>