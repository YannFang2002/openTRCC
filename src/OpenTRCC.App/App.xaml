<Application x:Class="OpenTRCC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="WindowBackground" Color="Transparent" />
            <SolidColorBrush x:Key="PanelBackground" Color="#66131C2C" />
            <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#E8EEF7" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9AA7B8" />
            <SolidColorBrush x:Key="Accent" Color="#2DD4BF" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="#33101828" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Padding" Value="2,1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
