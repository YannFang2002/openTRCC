<UserControl x:Class="OpenTRCC.App.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <ComboBox x:Name="ThemePicker" Width="150" Margin="0,0,10,6"
                          DisplayMemberPath="Name" SelectionChanged="OnThemePicked" />
                <ui:Button Content="文字" Click="OnAddText" Margin="0,0,6,6" />
                <ui:Button Content="条形" Click="OnAddBar" Margin="0,0,6,6" />
                <ui:Button Content="环形" Click="OnAddRing" Margin="0,0,6,6" />
                <ui:Button Content="曲线" Click="OnAddSparkline" Margin="0,0,6,6" />
                <ui:Button Content="图片" Click="OnAddImage" Margin="0,0,6,6" />
                <ui:Button Content="矩形" Click="OnAddRect" Margin="0,0,6,6" />
                <ui:Button Content="撤销" Click="OnUndo" Margin="0,0,6,6" />
                <ui:Button Content="重做" Click="OnRedo" Margin="0,0,6,6" />
                <ui:Button Content="新建主题" Click="OnNewTheme" Margin="0,0,6,6" />
                <ui:Button Content="另存为" Click="OnSaveAs" Margin="0,0,6,6" />
                <ui:Button Content="删除主题" Click="OnDeleteTheme" Margin="0,0,6,6" />
                <ui:Button Content="保存" Appearance="Primary" Click="OnSave" Margin="0,0,0,6" />
            </WrapPanel>

            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="EditorStatus" Foreground="{StaticResource TextSecondary}" FontSize="11"
                           Text="拖动选中图层可移动；属性面板可改位置/尺寸/颜色/绑定。" />
            </Border>

            <Border Background="#33101828" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="CanvasHost" Width="640" Height="480" ClipToBounds="True"
                      MouseLeftButtonDown="OnCanvasMouseDown"
                      MouseLeftButtonUp="OnCanvasMouseUp"
                      MouseMove="OnCanvasMouseMove">
                    <Image x:Name="CanvasImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                        <Border x:Name="SelectionBox" BorderBrush="#2DD4BF" BorderThickness="2"
                                Visibility="Collapsed" />
                    </Canvas>
                </Grid>
                </Viewbox>
            </Border>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="图层" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6" />
            <ListBox x:Name="LayerList" Grid.Row="1" Height="170"
                     SelectionChanged="OnLayerSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Id}" Margin="8,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,2,0">
                <ui:Button Content="↑" Width="30" Padding="0" Click="OnMoveUp" Margin="0,0,4,0" />
                <ui:Button Content="↓" Width="30" Padding="0" Click="OnMoveDown" Margin="0,0,4,0" />
                <ui:Button Content="复制" Click="OnDuplicateLayer" Margin="0,0,4,0" />
                <ui:Button Content="删除" Click="OnDeleteLayer" />
            </StackPanel>

            <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropsPanel" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
