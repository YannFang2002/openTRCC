      "min": 0, "max": 100,
      "thickness": 9,
      "track": "#1E293B",
      "fill": ["#2DD4BF"],
      "startAngle": 135,
      "sweepAngle": 270,
      "cap": "round"
    },
    {
      "type": "text",
      "id": "cpu-value",
      "x": 20, "y": 16, "w": 110, "h": 110,
