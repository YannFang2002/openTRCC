{
  "schemaVersion": 1,
  "id": "overview-320x240",
  "name": "总览",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": {
      "kind": "gradient",
      "colors": ["#080D18", "#12203A", "#080D18"],
      "angle": 90,
      "dim": 0
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "cpu-label",
      "x": 0, "y": 2, "w": 150, "h": 14,
      "text": "CPU",
      "font": { "family": "Microsoft YaHei UI", "size": 10, "weight": 600 },
      "color": "#94A3B8",
      "align": "center"
    },
    {
      "type": "ring",
      "id": "cpu-ring",
