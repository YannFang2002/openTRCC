      "color": "#E2E8F0",
      "align": "center",
      "verticalAlign": "middle"
    },
    {
      "type": "text",
      "id": "cpu-temp",
      "x": 0, "y": 132, "w": 150, "h": 16,
      "text": "{cpu.temp.package:0}°",
      "font": { "family": "Microsoft YaHei UI", "size": 10, "weight": 500 },
      "color": "#F59E0B",
      "align": "center"
    },
    {
      "type": "text",
      "id": "gpu-label",
      "x": 170, "y": 2, "w": 150, "h": 14,
      "text": "GPU",
      "font": { "family": "Microsoft YaHei UI", "size": 10, "weight": 600 },
      "color": "#94A3B8",
      "align": "center"
    },
    {
      "type": "ring",
      "id": "gpu-ring",
      "x": 190, "y": 16, "w": 110, "h": 110,
      "value": "{gpu.load.core}",
      "min": 0, "max": 100,
      "thickness": 9,
      "track": "#1E293B",
      "fill": ["#A855F7"],
      "startAngle": 135,
      "sweepAngle": 270,
      "cap": "round"
    },
    {
      "type": "text",
      "id": "gpu-value",
      "x": 190, "y": 16, "w": 110, "h": 110,
